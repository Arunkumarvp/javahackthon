.idea/
*.iml
*.ipr
*.iws
out/
gen/

# Eclipse
.classpath
.project
.settings/
bin/

# VS Code
.vscode/
!.vscode/extensions.json
*.code-workspace
.history/

# ------------------------------------------------------------------------------
# Frontend (React / Vite / Node.js)
# ------------------------------------------------------------------------------
frontend/node_modules/
node_modules/
frontend/dist/
dist/
frontend/build/
build/
frontend/.npm
.npm
frontend/.eslintcache
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

