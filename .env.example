# ─────────────────────────────────────────────────────────────────────────────
# AI Financial Guardian — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── OpenRouter LLM API ───────────────────────────────────────────────────────
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Model to use (any model available on OpenRouter)
# Options: anthropic/claude-3.5-sonnet | openai/gpt-4o | google/gemini-pro | etc.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Request timeout in milliseconds
OPENROUTER_TIMEOUT_MS=30000

# Your app's public URL (required by OpenRouter HTTP-Referer header policy)
APP_URL=http://localhost:8080

# ─── Database ─────────────────────────────────────────────────────────────────
# For development: leave blank to use H2 in-memory (no setup required)
# For production: Neon/Supabase PostgreSQL connection string
DATABASE_URL=jdbc:postgresql://your-neon-host/aiguardian?sslmode=require
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_USERNAME=your-db-username
DATABASE_PASSWORD=your-db-password
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# ─── RAG Service ──────────────────────────────────────────────────────────────
# Python FastAPI RAG retrieval service (ai-core/rag/service.py)
RAG_SERVICE_URL=http://localhost:8001

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── Spring Profile ───────────────────────────────────────────────────────────
# Use 'demo' profile for H2 in-memory database (no PostgreSQL required)
# SPRING_PROFILES_ACTIVE=demo
